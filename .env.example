# Swizzo environment. Copy this file to .env.local for local dev. On Vercel, set the
# same names under Project Settings → Environment Variables.
# The server checks these at boot (src/backend/config/env-schema.ts). GET /api/ready
# lists anything missing, by name only.
# All keys are server-only. Never prefix a secret with NEXT_PUBLIC_.

# ── LLM provider chain (tried in this order; a blank key is skipped) ── REQUIRED: at least one
# 1. Anthropic: Claude Haiku
ANTHROPIC_API_KEY=
# 2–3. Groq main account, then a second account (gpt-oss-120b → gpt-oss-20b → qwen)
GROQ_API_KEY=
GROQ_API_KEY_2=
# 4–5. Gemini main account, then a second account
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# ── App origin ── REQUIRED in production
# Public origin, no trailing slash. The OAuth redirect is <APP_BASE_URL>/api/auth/callback.
# It must exactly match what Swiggy allowlisted. Locally this must stay http://localhost:3000.
# In production it must be https://<your-domain>.
APP_BASE_URL=http://localhost:3000
# Optional: override the full redirect URI (normally derived from APP_BASE_URL).
# SWIGGY_OAUTH_REDIRECT_URI=

# ── Session ── REQUIRED in production
# Encrypts the per-user Swiggy session cookie: 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=

# ── Swiggy OAuth / MCP ──
# "swiggy-mcp" only works for localhost. Production needs the client id Swiggy issues for your domain.
SWIGGY_OAUTH_CLIENT_ID=swiggy-mcp
# Real order placement and confirm_order. Anything except "true" disables ordering, and the
# server answers honestly that the order was not placed.
SWIGGY_ENABLE_ORDERS=false
# Staging: https://mcp-staging.swiggy.com and https://mcp-staging.swiggy.com/auth
# SWIGGY_MCP_BASE=https://mcp.swiggy.com
# SWIGGY_AUTH_BASE=https://mcp.swiggy.com/auth
# Optional default address id for a single-user local setup. Normally the user picks one.
# SWIGGY_DEFAULT_ADDRESS_ID=

# ── Persistence (optional, see docs/DATABASE.md) ──
# Unset means chats and bookings stay in browser localStorage only.
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_URL_UNPOOLED=
# DATABASE_POOL_MAX=5

# ── Security knobs (optional, see docs/SECURITY.md) ──
# Extra comma-separated origins allowed to POST (custom domains are covered by APP_BASE_URL).
# ALLOWED_ORIGINS=
# Local only. Ignored in production.
# RATE_LIMIT_DISABLED=false

# ── Observability (optional) ──
# debug | info | warn | error   (default: info in production, debug in dev)
# LOG_LEVEL=info
# json | pretty                 (default: json in production, pretty in dev)
# LOG_FORMAT=json
# 1 loads Vercel Web Analytics + Speed Insights. Turn both on in the Vercel project first.
# NEXT_PUBLIC_VERCEL_ANALYTICS=0

# ── Local debugging only ──
# Appends every raw MCP tool result to this file (JSONL). Ignored on Vercel and in production.
# SWIGGY_DEBUG_DUMP=/tmp/swiggy-dump.jsonl
