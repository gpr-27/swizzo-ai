{
  "name": "swizzo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:heap": "NODE_OPTIONS='--max-old-space-size=4096 --heapsnapshot-near-heap-limit=2' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait postgres || docker-compose up -d --wait postgres",
    "db:down": "docker compose down || docker-compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx --tsconfig tsconfig.json scripts/verify-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project node --project components",
    "test:watch": "vitest --project node --project components",
    "test:coverage": "vitest run --project node --project components --coverage",
    "test:live": "vitest run --project live",
    "test:e2e": "playwright test --project smoke --project smoke-mobile",
    "test:e2e:live": "playwright test --project logged-in"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/groq": "^4.0.67",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/qrcode": "^1.5.5",
    "ai": "^7.0.148",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
